# Copy to .env and fill in the values. Leave empty values below as-is in the
# example file; real secrets must only live in .env (never committed).

# Required when using Docker Compose infrastructure
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Comma-separated API keys for the gateway. When set, only /health is public.
API_KEYS=

# Host the gateway binds to. Keep loopback unless API_KEYS is set.
GATEWAY_HOST=127.0.0.1

# OmniRoute gateway credentials
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
